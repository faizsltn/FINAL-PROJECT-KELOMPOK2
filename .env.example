# ==========================================================
# AI COURSE GENERATOR - ENVIRONMENT VARIABLES
# Salin file ini menjadi ".env" lalu isi dengan nilai asli.
# JANGAN commit file ".env" ke repository (sudah ada di .gitignore)
# ==========================================================

# Port server dijalankan
PORT=3000

# Mode aplikasi: development | production
NODE_ENV=development

# Secret untuk session cookie (isi dengan string acak yang panjang)
SESSION_SECRET=ganti-dengan-random-string-yang-sangat-rahasia

# Lokasi file database SQLite
DATABASE_PATH=./database/aicourse.sqlite

# API Key Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=isi_api_key_gemini_disini
GEMINI_MODEL=gemini-3.6-flash

# API Key YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=isi_api_key_youtube_disini

# Base URL aplikasi (dipakai untuk membuat link reset password)
APP_BASE_URL=http://localhost:3000
