<div class="max-w-md mx-auto py-8 sm:py-12">
  <div class="text-center mb-7">
    <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-soft mb-4">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="16" r="1.5" fill="currentColor"/></svg>
    </span>
    <h1 class="font-display text-2xl font-bold text-ink-900">Reset Password</h1>
    <p class="text-ink-700/60 text-sm mt-1">Masukkan password baru untuk akunmu.</p>
  </div>

  <form action="/auth/reset-password/<%= token %>" method="POST" class="card p-6 sm:p-7 space-y-4">
    <div>
      <label class="field-label">Password Baru</label>
      <input type="password" name="password" required minlength="6" placeholder="Minimal 6 karakter"
        class="field-input" />
    </div>
    <div>
      <label class="field-label">Konfirmasi Password Baru</label>
      <input type="password" name="confirmPassword" required minlength="6" placeholder="Ulangi password baru"
        class="field-input" />
    </div>
    <button type="submit" class="btn btn-primary w-full py-2.5">
      Simpan Password Baru
    </button>
  </form>
</div>
