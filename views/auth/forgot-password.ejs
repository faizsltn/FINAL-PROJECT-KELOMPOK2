<div class="max-w-md mx-auto py-8 sm:py-12">
  <div class="text-center mb-7">
    <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-soft mb-4">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="2"/></svg>
    </span>
    <h1 class="font-display text-2xl font-bold text-ink-900">Lupa Password</h1>
    <p class="text-ink-700/60 text-sm mt-1">Masukkan email akunmu, kami akan buatkan tautan reset.</p>
  </div>

  <div class="card p-6 sm:p-7 space-y-4">
    <% if (typeof resetLink !== 'undefined' && resetLink) { %>
      <div class="rounded-xl border border-amber-100 bg-amber-50 p-4 text-sm text-amber-700">
        <p class="mb-2"><%= infoMessage %></p>
        <a href="<%= resetLink %>" class="block break-all font-medium text-brand-700 hover:underline"><%= resetLink %></a>
      </div>
    <% } %>

    <form action="/auth/forgot-password" method="POST" class="space-y-4">
      <div>
        <label class="field-label">Email</label>
        <input type="email" name="email" required placeholder="nama@email.com"
          class="field-input" />
      </div>
      <button type="submit" class="btn btn-primary w-full py-2.5">
        Kirim Tautan Reset
      </button>
    </form>

    <p class="text-center text-sm text-ink-700/60">
      <a href="/auth/login" class="text-brand-600 font-semibold hover:underline">Kembali ke halaman masuk</a>
    </p>
  </div>
</div>
