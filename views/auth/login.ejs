<div class="max-w-md mx-auto py-8 sm:py-12">
  <div class="text-center mb-7">
    <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-soft mb-4">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="2"/><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </span>
    <h1 class="font-display text-2xl font-bold text-ink-900">Masuk ke Akunmu</h1>
    <p class="text-ink-700/60 text-sm mt-1">Lanjutkan perjalanan belajar mandirimu.</p>
  </div>

  <form action="/auth/login" method="POST" class="card p-6 sm:p-7 space-y-4">
    <div>
      <label class="field-label">Email</label>
      <input type="email" name="email" value="<%= oldInput.email || '' %>" required placeholder="nama@email.com"
        class="field-input" />
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <label class="field-label mb-0">Password</label>
        <a href="/auth/forgot-password" class="text-xs text-brand-600 font-medium hover:underline">Lupa password?</a>
      </div>
      <div class="relative">
        <input id="login-password" type="password" name="password" required placeholder="••••••••"
          class="field-input pr-10" />
        <button type="button" data-toggle-password="login-password" class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-700/40 hover:text-brand-600" tabindex="-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
        </button>
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-full py-2.5">
      Masuk
    </button>

    <p class="text-center text-sm text-ink-700/60">
      Belum punya akun? <a href="/auth/register" class="text-brand-600 font-semibold hover:underline">Daftar di sini</a>
    </p>

    <div class="border-t border-ink-900/5 pt-3 text-center text-xs text-ink-700/45">
      Akun demo: <code class="bg-ink-900/5 px-1.5 py-0.5 rounded">mahasiswa.demo@example.com</code> / <code class="bg-ink-900/5 px-1.5 py-0.5 rounded">password123</code>
      <br />(tersedia setelah menjalankan <code class="bg-ink-900/5 px-1.5 py-0.5 rounded">npm run seed</code>)
    </div>
  </form>
</div>
