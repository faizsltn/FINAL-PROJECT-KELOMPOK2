<div class="mb-6">
  <a href="/outlines" class="inline-flex items-center gap-1.5 text-sm text-ink-700/55 hover:text-brand-600 font-medium">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Kembali ke daftar outline
  </a>
</div>

<div class="card p-6 mb-6">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="flex-1 min-w-[240px]">
      <span class="badge <%= outline.status === 'lengkap' ? 'badge-complete' : 'badge-draft' %>">
        <%= outline.status === 'lengkap' ? 'Kursus Lengkap' : 'Draft Outline' %>
      </span>
      <h1 class="font-display text-2xl font-bold text-ink-900 mt-2"><%= outline.title %></h1>
      <p class="text-ink-700/60 text-sm mt-1"><%= outline.description %></p>
      <p class="text-xs text-ink-700/40 mt-2">Topik asli: &ldquo;<%= outline.topic %>&rdquo;</p>
    </div>

    <button onclick="document.getElementById('edit-title-form').classList.toggle('hidden')"
      class="btn btn-secondary btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Edit Judul
    </button>
  </div>

  <form id="edit-title-form" action="/outlines/<%= outline.id %>" method="POST" class="hidden mt-4 pt-4 border-t border-ink-900/5 space-y-3">
    <div>
      <label class="field-label">Judul Outline</label>
      <input type="text" name="title" value="<%= outline.title %>" required class="field-input" />
    </div>
    <div>
      <label class="field-label">Deskripsi</label>
      <textarea name="description" rows="2" class="field-input resize-none"><%= outline.description %></textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
  </form>

  <!-- Aksi utama -->
  <div class="flex flex-wrap gap-2 mt-5 pt-5 border-t border-ink-900/5">
    <form action="/outlines/<%= outline.id %>/convert" method="POST" onsubmit="return handleConvertSubmit(this)">
      <button type="submit" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z"/></svg>
        <%= outline.status === 'lengkap' ? 'Regenerasi Kursus Lengkap' : 'Konversi Jadi Kursus Lengkap' %>
      </button>
    </form>

    <% if (outline.status === 'lengkap') { %>
      <a href="/courses/<%= outline.id %>" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 19.5V6a2 2 0 012-2h9a2 2 0 012 2v9a2 2 0 01-2 2H8l-4 4.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        Buka Halaman Belajar
      </a>
    <% } %>

    <form action="/outlines/<%= outline.id %>/regenerate" method="POST" onsubmit="return confirm('Yakin ingin meregenerasi seluruh outline ini? Level & sub-topik saat ini akan diganti.');">
      <button type="submit" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 4v6h6M20 20v-6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 10a8 8 0 0114.6-4.6M20 14a8 8 0 01-14.6 4.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Regenerasi Outline
      </button>
    </form>

    <form action="/outlines/<%= outline.id %>/continue-level" method="POST">
      <button type="submit" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Lanjutkan Level
      </button>
    </form>

    <form action="/outlines/<%= outline.id %>/delete" method="POST" onsubmit="return confirm('Yakin ingin menghapus outline ini? Tindakan tidak bisa dibatalkan.');" class="sm:ml-auto">
      <button type="submit" class="btn btn-danger">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0l-1 14a2 2 0 01-2 2H7a2 2 0 01-2-2L4 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Hapus
      </button>
    </form>
  </div>
</div>

<!-- Daftar level & sub-topik -->
<div class="space-y-4">
  <% outline.levels.forEach(function(level, levelIdx) { %>
    <div class="card p-5">
      <div class="flex items-center gap-3 flex-wrap justify-between">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-ink-900 text-white font-display font-bold text-sm flex items-center justify-center shrink-0"><%= levelIdx + 1 %></span>
          <h2 class="font-display font-semibold text-ink-900"><%= level.level_title %></h2>
        </div>
        <button onclick="document.getElementById('edit-level-<%= level.id %>').classList.toggle('hidden')"
          class="btn btn-ghost btn-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Edit
        </button>
      </div>

      <form id="edit-level-<%= level.id %>" action="/outlines/<%= outline.id %>/levels/<%= level.id %>" method="POST" class="hidden mt-3 flex gap-2 pl-12">
        <input type="text" name="levelTitle" value="<%= level.level_title %>" required class="field-input flex-1" />
        <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
      </form>

      <ul class="mt-3 space-y-2 pl-12">
        <% level.subtopics.forEach(function(sub, subIdx) { %>
          <li class="flex items-center justify-between gap-2 rounded-xl bg-paper-200/60 px-3.5 py-2.5 text-sm">
            <span class="text-ink-800"><span class="text-ink-700/40 font-medium"><%= levelIdx + 1 %>.<%= subIdx + 1 %></span> <%= sub.title %></span>
            <button onclick="document.getElementById('edit-sub-<%= sub.id %>').classList.toggle('hidden')"
              class="text-ink-700/35 hover:text-brand-600 shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </li>
          <form id="edit-sub-<%= sub.id %>" action="/outlines/<%= outline.id %>/subtopics/<%= sub.id %>" method="POST" class="hidden flex gap-2">
            <input type="text" name="subtopicTitle" value="<%= sub.title %>" required class="field-input flex-1" />
            <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
          </form>
        <% }) %>
      </ul>
    </div>
  <% }) %>
</div>

<script>
  function handleConvertSubmit(form) {
    const btn = form.querySelector('button');
    btn.disabled = true;
    btn.innerHTML = '<svg class="animate-spin" width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.25"/><path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg> Sedang membuat materi & mencari video... (bisa memakan waktu 1-2 menit)';
    btn.classList.add('opacity-70', 'cursor-not-allowed');
    return true;
  }
</script>
