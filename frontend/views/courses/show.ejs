<div class="mb-6">
  <a href="/courses" class="inline-flex items-center gap-1.5 text-sm text-ink-700/55 hover:text-brand-600 font-medium">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Kembali ke daftar kursus
  </a>
</div>

<div class="card p-6 mb-6">
  <span class="badge badge-complete">Kursus Lengkap</span>
  <h1 class="font-display text-2xl font-bold text-ink-900 mt-2"><%= course.title %></h1>
  <p class="text-ink-700/60 text-sm mt-1"><%= course.description %></p>
  <a href="/outlines/<%= course.id %>" class="inline-flex items-center gap-1 mt-3 text-xs font-semibold text-brand-600 hover:underline">
    Kelola outline kursus ini
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>

<!-- Navigasi cepat antar level -->
<div class="sticky top-16 z-30 -mx-4 sm:mx-0 px-4 sm:px-0 py-2.5 mb-6 bg-paper/90 backdrop-blur">
  <div class="flex gap-2 overflow-x-auto thin-scroll pb-1">
    <% course.levels.forEach(function(level, idx) { %>
      <a href="#level-<%= level.id %>" class="whitespace-nowrap chip">
        Level <%= idx + 1 %>: <%= level.level_title %>
      </a>
    <% }) %>
  </div>
</div>

<div class="space-y-10">
  <% course.levels.forEach(function(level, levelIdx) { %>
    <section id="level-<%= level.id %>" class="scroll-mt-32">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-9 h-9 rounded-xl bg-ink-900 text-white font-display font-bold text-sm flex items-center justify-center shrink-0"><%= levelIdx + 1 %></span>
        <h2 class="font-display text-lg font-bold text-ink-900"><%= level.level_title %></h2>
      </div>

      <div class="space-y-6">
        <% level.subtopics.forEach(function(sub, subIdx) { %>
          <div class="card p-5 sm:p-6">
            <h3 class="font-display font-semibold text-ink-900 mb-3">
              <span class="text-brand-600"><%= levelIdx + 1 %>.<%= subIdx + 1 %></span> <%= sub.title %>
            </h3>

            <% if (sub.material) { %>
              <div class="material-prose text-sm whitespace-pre-wrap"><%= sub.material %></div>
            <% } else { %>
              <p class="text-sm text-ink-700/45 italic">Materi untuk sub-topik ini belum berhasil dibuat. Coba konversi ulang dari halaman outline.</p>
            <% } %>

            <% if (sub.videos && sub.videos.length > 0) { %>
              <div class="mt-5 pt-5 border-t border-ink-900/5">
                <p class="text-xs font-semibold text-ink-700/55 mb-3 flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="14" height="12" rx="2" stroke="currentColor" stroke-width="2"/><path d="M17 10l4-2.5v9L17 14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                  Video Pembelajaran Terkait
                </p>
                <div class="grid sm:grid-cols-3 gap-3">
                  <% sub.videos.forEach(function(v) { %>
                    <a href="<%= v.url %>" target="_blank" rel="noopener noreferrer" class="block rounded-xl overflow-hidden border border-ink-900/5 hover:shadow-lift transition group">
                      <div class="video-thumb">
                        <img src="<%= v.thumbnail_url %>" alt="<%= v.title %>" class="w-full aspect-video object-cover bg-ink-900/5" />
                        <span class="play-badge">
                          <span class="w-9 h-9 rounded-full bg-white/90 flex items-center justify-center group-hover:scale-105 transition">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#12121A"><path d="M8 5v14l11-7z"/></svg>
                          </span>
                        </span>
                      </div>
                      <p class="text-xs p-2.5 line-clamp-2 text-ink-800 font-medium"><%= v.title %></p>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } else { %>
              <p class="mt-5 pt-5 border-t border-ink-900/5 text-xs text-ink-700/45 italic">Belum ada video relevan yang ditemukan untuk sub-topik ini.</p>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
  <% }) %>
</div>

<%- include('../partials/chatbot-widget', { outlineId: course.id, courseTitle: course.title }) %>
